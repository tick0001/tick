# Jeu de donnees d'annuaire pour le developpement et les tests d'integration.
#
# Deux unites d'organisation, deux comptes et deux groupes : le minimum pour
# eprouver le parcours complet, y compris la revocation d'une habilitation
# quand un compte quitte un groupe.
#
# Les mots de passe sont en clair : cet annuaire n'existe qu'en local et en
# integration continue, et n'est jamais expose.

dn: ou=users,dc=exemple,dc=fr
objectClass: organizationalUnit
ou: users

dn: ou=groups,dc=exemple,dc=fr
objectClass: organizationalUnit
ou: groups

