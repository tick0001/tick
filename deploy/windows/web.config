<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration IIS de l'interface Tick&.

  Installation : C:\Tick\web\web.config, à la racine du site.
  Voir docs/17-installation-windows.md.

  Deux modules IIS sont requis, et ils ne sont pas installés par défaut :
  URL Rewrite, et Application Request Routing. Sans ARR, la règle de relais
  ci-dessous est acceptée mais ne relaie rien — elle renvoie une 404. Le proxy
  d'ARR doit en outre être activé au niveau du serveur.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!--
          Relais vers l'API, sur la boucle locale.

          Même origine que l'interface, à dessein : le cookie de session est
          `httpOnly` et `SameSite`, et ne voyagerait pas entre deux domaines.

          Cette règle passe avant le repli sur l'index : dans l'ordre inverse,
          `/api/tickets` serait servi comme une route de l'interface.
        -->
        <rule name="API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}" />
        </rule>

        <!--
          Repli sur l'index.

          Les routes de l'application n'existent pas sur le disque :
          `/tickets/42` est traité par le routeur du navigateur. Sans ce repli,
          un rechargement de page — ou un lien partagé — renverrait une 404.
        -->
        <rule name="Interface" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

    <!--
      Les pièces jointes et les exports peuvent être volumineux. La limite par
      défaut d'IIS est de 30 Mo côté requête et de 4 Mo côté ASP.NET ; c'est
      la seconde qui rejette en premier un journal d'incident joint à un ticket.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!--
      IIS refuse de servir une extension qu'il ne connaît pas. Les polices et le
      manifeste ne figurent pas dans la table par défaut des installations
      anciennes, et leur absence se manifeste par une interface sans police et
      une 404 discrète dans la console.
    -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

  </system.webServer>
</configuration>
