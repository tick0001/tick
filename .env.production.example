# Configuration d'un déploiement Tick&.
#
# Copier en `.env` à côté du fichier compose, puis remplir. Les variables sans
# valeur par défaut sont obligatoires : le compose refuse de démarrer si l'une
# manque, plutôt que de lancer un service qui échouera plus tard sur une erreur
# sans rapport.

# --- Images -------------------------------------------------------------------
TICK_VERSION=latest
# TICK_IMAGE_API=ghcr.io/tick0001/tick-api
# TICK_IMAGE_WEB=ghcr.io/tick0001/tick-web

# Port d'écoute de l'interface sur la machine hôte. L'API n'est pas publiée :
# elle n'est jointe que par le relais interne.
TICK_PORT=8080

# --- Adresses publiques -------------------------------------------------------
# Telles que les navigateurs les voient. Elles servent à composer les liens des
# notifications : une adresse fausse produit des courriels dont les liens ne
# mènent nulle part, ce qui ne se découvre qu'à la première notification.
API_URL=https://assistance.exemple.fr
WEB_URL=https://assistance.exemple.fr

# --- Base de données ----------------------------------------------------------
POSTGRES_USER=tick
POSTGRES_PASSWORD=
POSTGRES_DB=tick

# Deux rôles, et ce n'est pas une précaution de style.
#
# `DATABASE_URL` est le propriétaire : il possède les tables et échappe au
# Row-Level Security. Il ne sert qu'aux migrations et à quelques lectures
# explicitement justifiées.
#
# `DATABASE_APP_URL` porte tout le trafic normal et **est** soumis aux
# politiques. Les intervertir reviendrait à désactiver le cloisonnement entre
# entités sans qu'aucun message ne le signale.
DATABASE_URL=postgres://tick:MOT_DE_PASSE@postgres:5432/tick
DATABASE_APP_URL=postgres://tick_app:MOT_DE_PASSE_APP@postgres:5432/tick

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Secrets ------------------------------------------------------------------
# Générer chacun avec : openssl rand -hex 32

# Signe les cookies de session. En changer déconnecte tout le monde.
SESSION_SECRET=

# Chiffre les secrets stockés en base — mots de passe des comptes de service
# d'annuaire et des boîtes relevées.
#
# La perdre les rend définitivement illisibles : il faudra ressaisir chaque
# mot de passe d'annuaire et de collecteur. À sauvegarder à part de la base,
# sans quoi une sauvegarde compromise livre les deux d'un coup.
ENCRYPTION_KEY=

# --- Courriel sortant ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=assistance@exemple.fr

# --- Divers -------------------------------------------------------------------
DEFAULT_LOCALE=fr
# error | warn | log | debug | verbose
LOG_LEVEL=log
